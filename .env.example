# Local dev against a local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/isimemo"

# Where generated guest images are written/read. Locally this can just be a
# folder in the repo; on Railway, point it at the mounted volume path.
GENERATED_DIR="./generated"

# Optional — leave unset to run in dev/demo mode, where checkout auto-marks
# the event as paid instead of calling Stripe (lets you test the full guest
# import -> generate -> deliver -> RSVP flow with no payment integration).
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
